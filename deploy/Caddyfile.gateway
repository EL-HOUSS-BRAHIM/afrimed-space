{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

(api) {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cache-Control no-store
		-Server
	}
}

lyvora.afrimed.space {
	import api
	reverse_proxy production-api:8787
}

lyvora-preview.afrimed.space {
	import api
	reverse_proxy preview-api:8787
}

afrimed.space {
	redir /lyvora https://lyvora-finance.tech/ 308
	redir /lyvora/ https://lyvora-finance.tech/ 308
	redir /lyvora/index.html https://lyvora-finance.tech/ 308
	redir /lyvora/download.html https://lyvora-finance.tech/download.html 308
	respond /lyvora-site/* 404
	root * /srv/afrimed
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		-Server
	}
	@presentation not path /lyvora/downloads/current/*
	header @presentation Cache-Control "public, max-age=300"
	header /lyvora/downloads/current/* {
		Cache-Control "no-store"
		CDN-Cache-Control "no-store"
		Cloudflare-CDN-Cache-Control "no-store"
	}
	file_server
}

www.lyvora-finance.tech {
	redir https://lyvora-finance.tech{uri} permanent
}

lyvora-finance.tech {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		-Server
	}
	handle /downloads/current/* {
		root * /srv/afrimed/lyvora
		header {
			Cache-Control "no-store"
			CDN-Cache-Control "no-store"
			Cloudflare-CDN-Cache-Control "no-store"
		}
		file_server
	}
	handle {
		root * /srv/afrimed/lyvora-site/current
		header Cache-Control "public, max-age=300"
		file_server
	}
	handle_errors {
		root * /srv/afrimed/lyvora-site/current
		rewrite * /404.html
		file_server
	}
}

import /etc/caddy/portfolio/*.caddy
